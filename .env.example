APP_NAME="Cyberbells LLC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# In a subfolder install this must include the folder, e.g.
# https://yourdomain.com/cyberbells_llc — invite links are built from it.
APP_URL=http://localhost:8000

# Shown across the portal and in every email
AGENCY_NAME="Cyberbells LLC"

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Database ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hireflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------- Mail ----------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="documents@hireflow.test"
MAIL_FROM_NAME="${AGENCY_NAME}"

# ---------- SMS gateway ----------
# log | twilio | vonage
SMS_DRIVER=log
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_FROM=Cyberbells

# ---------- Portal behaviour ----------
INVITE_VALID_DAYS=14
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_SENDS_PER_HOUR=6
OTP_ALSO_EMAIL=true
# Local testing only — prints the code on screen. NEVER enable in production.
OTP_EXPOSE=true

DOCUMENT_DISK=documents
DOCUMENT_MAX_SIZE_KB=8192

# ---------- First admin (used by the seeder) ----------
SEED_ADMIN_NAME="Agency Owner"
SEED_ADMIN_EMAIL=admin@hireflow.test
SEED_ADMIN_PASSWORD=Password@123

# Uploads go straight into the review queue. Set false to wait for the candidate to submit.
REVIEW_AUTO_UNDER_REVIEW=true

# Shared hosting only: absolute path to the folder that is actually served,
# when the contents of public/ have been moved outside the project.
# PUBLIC_PATH=/home/username/public_html/cyberbells_llc
